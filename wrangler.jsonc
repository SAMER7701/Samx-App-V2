{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "samx-app",
  "main": "worker.js",
  "compatibility_date": "2024-10-01",
  "assets": {
    "directory": ".",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "samx-db",
      "database_id": "samx-db"
    }
  ]
}
